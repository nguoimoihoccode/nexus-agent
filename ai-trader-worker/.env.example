DB_PATH=../data/ai-trader/clawtrader.db
NEXUS_ENV=development
NEXUS_LOG_LEVEL=INFO
NEXUS_LOG_FORMAT=json

# Worker-side auth and market-intel refresh settings.
# Keep AI_TRADER_TOKEN equal to backend/.env when protected worker endpoints
# are needed.
AI_TRADER_TOKEN=
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ALPHA_VANTAGE_ALLOWED_HOSTS=www.alphavantage.co
AI_TRADER_MARKET_NEWS_LOOKBACK_HOURS=48
AI_TRADER_MARKET_NEWS_LIMIT=50
AI_TRADER_MARKET_NEWS_CATEGORIES=equities,macro,crypto,commodities
AI_TRADER_MARKET_NEWS_REFRESH_INTERVAL_SECONDS=3600
AI_TRADER_MARKET_NEWS_REFRESH_STARTUP_DELAY_SECONDS=3
AI_TRADER_MARKET_NEWS_STALE_AFTER_SECONDS=7200
