# Environment template for the demo profile.
#
# This is the content of the GitHub Environment secret `DEMO_ENV`. Fill in a
# copy, then paste it into that secret; the deploy workflow writes it to
# /opt/nexus/nexus-agent/.env on the host with mode 600 on every deploy, and
# deploy/remote-deploy.sh pins NEXUS_IMAGE_TAG into it.
#
# Never commit a filled-in copy. `.gitignore` already covers `*.env`.

# PostgreSQL. The value reaches both the server and the backend, so it is the
# only database credential the demo needs.
POSTGRES_PASSWORD=

# Model and search credentials.
DEEPSEEK_API_KEY=
TAVILY_API_KEY=

# Where the model is served, and which model to ask for. docker-compose.demo.yml
# requires both and gives neither a usable default.
#   MODEL              LangChain model id, written "provider:name" -- for
#                      DeepSeek's own API that is deepseek:deepseek-chat.
#   DEEPSEEK_API_BASE  Endpoint base URL. Point it at an OpenAI-compatible
#                      gateway to route the model elsewhere. Do not leave it
#                      empty: an empty value does not fall back to the provider
#                      default, it makes the client build relative URLs like
#                      /chat/completions. Write https://api.deepseek.com/v1 to
#                      mean "DeepSeek itself".
MODEL=
DEEPSEEK_API_BASE=

# Shared secret for the AI-Trader worker. The worker answers 503 on its
# protected routes when this is empty, so set the same value on both sides --
# they already share this one variable.
# Generate with: openssl rand -hex 32
AI_TRADER_TOKEN=

# Optional market data.
ALPHA_VANTAGE_API_KEY=

# Written by deploy/remote-deploy.sh on each deploy. Leave it out of the secret
# unless you want to pin a specific build by hand.
# NEXUS_IMAGE_TAG=

# The frontend stays on loopback; the host nginx is the only public entry point.
# Change APP_PORT if 8080 is already taken on the host.
APP_BIND_HOST=127.0.0.1
APP_PORT=8080