{
  "name": "nexus-harness-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "NEXUS_FRONTEND_HOST=0.0.0.0 NEXUS_TRUSTED_LAN=1 vite",
    "generate:routes": "tsr generate",
    "typecheck": "npm run generate:routes && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "npm run generate:routes && vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "lucide-react": "^1.52.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tanstack/router-cli": "1.167.40",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.13 <23"
  }
}
