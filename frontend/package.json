{
  "name": "nexus-harness-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "NEXUS_FRONTEND_HOST=0.0.0.0 NEXUS_TRUSTED_LAN=1 vite",
    "generate:routes": "tsr generate",
    "typecheck": "npm run generate:routes && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "npm run generate:routes && vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.18",
    "lucide-react": "^0.468.0",
    "radix-ui": "1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tanstack/router-cli": "1.167.19",
    "@tanstack/router-plugin": "1.168.20",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13 <23"
  }
}
