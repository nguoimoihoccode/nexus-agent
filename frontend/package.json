{
  "name": "nexus-harness-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "NEXUS_FRONTEND_HOST=0.0.0.0 NEXUS_TRUSTED_LAN=1 vite",
    "generate:routes": "tsr generate",
    "typecheck": "npm run generate:routes && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "npm run generate:routes && vitest run",
    "test:e2e": "npm run build && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "lucide-react": "^1.69.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@tanstack/router-cli": "1.167.46",
    "@tanstack/router-plugin": "1.168.48",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.13 <23"
  }
}
